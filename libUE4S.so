                                } else if (Config.AimBot.Trigger == EAimTrigger::Both) {
                                    triggerOk = localPlayer->bIsWeaponFiring && localPlayer->bIsGunADS;
                                } else if (Config.AimBot.Trigger == EAimTrigger::Any) {
